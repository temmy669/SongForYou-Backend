# Copy to .env and fill in. Never commit .env.

# Django
# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=
DEBUG=True

# The three below are only needed when DEBUG=False (production).
# With DEBUG=True they are ignored and permissive dev values are used instead.
# All are comma-separated.
#   ALLOWED_HOSTS       hostnames only, no scheme   e.g. songforyou.app,www.songforyou.app
#   CSRF_TRUSTED_ORIGINS / CORS_ALLOWED_ORIGINS     scheme required
#
# On Render, ALLOWED_HOSTS and CSRF_TRUSTED_ORIGINS may be left blank: the app
# trusts RENDER_EXTERNAL_HOSTNAME automatically. Set them once you attach a
# custom domain. CORS_ALLOWED_ORIGINS is NOT automatic - the frontend cannot
# call the API until its origin is listed here.
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=
CORS_ALLOWED_ORIGINS=

# HSTS — browsers CACHE this and it cannot be undone by redeploying.
# Ramp: deploy at 3600, confirm HTTPS everywhere, then raise to 31536000.
# Leave at 0 for the first deploy.
SECURE_HSTS_SECONDS=0

# PostgreSQL (Neon)
# Set DATABASE_URL and the DB_* vars below are ignored entirely.
#
# Copy the connection string from the Neon console. Use the POOLED endpoint
# (host contains '-pooler') and keep ?sslmode=require:
# DATABASE_URL=postgresql://user:pass@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
#
# Optional tuning:
#   DB_CONN_MAX_AGE          seconds to reuse a connection (default 600)
#   DB_SERVER_SIDE_CURSORS   set True ONLY on a direct, non-pooled endpoint
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Spotify OAuth — https://developer.spotify.com/dashboard
# Register BOTH redirect URIs there - local and production - or login breaks in
# whichever environment is missing:
#   http://localhost:8000/accounts/spotify/login/callback/
#   https://<your-render-host>/accounts/spotify/login/callback/
# Redirect URI must be registered there as:
#   <backend-url>/accounts/spotify/login/callback/
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Frontend
FRONTEND_URL=http://localhost:3000
